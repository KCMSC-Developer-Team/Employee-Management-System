# ───────────────────────────────────────────────────────────────
# K C Model School & College — Employee Management System
# Copy this file to .env.local (local) or add each value in
# Vercel → Project → Settings → Environment Variables.
# ───────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (Neon dashboard → Connect → pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign login cookies. Generate with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Public address of the site (no trailing slash). Used in e-mail links.
APP_URL=https://your-project.vercel.app

# Resend (https://resend.com) — password / invite / notification e-mails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a sender on a domain you verified in Resend
EMAIL_FROM=K C Model School & College <noreply@your-domain.edu.bd>

# Browser push notifications — generate once with:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.edu.bd

# The built-in Developer e-mail is zarif@kcmsc.edu.bd. Whoever creates an account with it
# becomes the first Developer automatically (open /setup once). Override only if needed:
# DEVELOPER_EMAIL=zarif@kcmsc.edu.bd

# Secret used by the class-reminder job (see README → "Class reminders")
CRON_SECRET=change-me-to-another-long-random-string
